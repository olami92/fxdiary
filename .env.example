# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Use a long random value and keep it stable so dashboard sessions survive restarts.
SESSION_SECRET=replace_with_a_long_random_secret

# AI Vision API Key for MT5 Screenshot Analysis (Gemini API / OpenAI API)
# Get a free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration. Locally defaults to SQLite; on Render set this to the
# Supabase PostgreSQL connection string, using the Session Pooler if available.
DATABASE_URL=sqlite+aiosqlite:///data/fxdiary.db

# Web App Server Settings
HOST=0.0.0.0
PORT=8000
WEB_APP_URL=http://localhost:8000
