# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Sheets Service Account Credentials
# Place your service account JSON file at credentials/google_credentials.json or put the JSON content in GOOGLE_SERVICE_ACCOUNT_JSON
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Master Google Sheet ID (if users don't provide their own sheet)
DEFAULT_GOOGLE_SHEET_ID=

# AI Vision API Key for MT5 Screenshot Analysis (Gemini API / OpenAI API)
# Get a free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Defaults to SQLite in data/fxdiary.db)
DATABASE_URL=sqlite+aiosqlite:///data/fxdiary.db

# Web App Server Settings
HOST=0.0.0.0
PORT=8000
WEB_APP_URL=http://localhost:8000
